# MENTORE Engine — Environment Configuration

# Server
ENVIRONMENT=development
PORT=8000
SECRET_KEY=antigravity_secret_study_desk_key
CORS_ORIGINS=["http://localhost:3000","http://localhost:3456"]

# Database & Vectors (PostgreSQL + pgvector)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_teacher_db

# Cache (Redis)
REDIS_URL=redis://localhost:6379/0

# LLM Providers
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key

# Multilingual Text-to-Speech
TTS_PROVIDER=elevenlabs
TTS_API_KEY=your_tts_api_key

# Object Storage (S3 / Supabase)
STORAGE_ENDPOINT=https://your-project.supabase.co/storage/v1/s3
STORAGE_BUCKET=lesson-materials
STORAGE_ACCESS_KEY=your_access_key
STORAGE_SECRET_KEY=your_secret_key
